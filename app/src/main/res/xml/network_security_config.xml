<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 很多网络电台仍然是明文 http 流，这里放开 cleartext，否则会播放失败 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
